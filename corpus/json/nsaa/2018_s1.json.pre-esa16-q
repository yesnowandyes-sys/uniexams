      "options": {
        "A": "\\frac{3}{22}",
        "B": "\\frac{5}{22}",
        "C": "\\frac{3}{11}",
        "D": "\\frac{1}{2}",
        "E": "\\frac{8}{11}",
        "F": "\\frac{17}{22}"
