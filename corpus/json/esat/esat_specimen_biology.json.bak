        "B": {
          "text": "1 and 2 only",
          "math_alt": [],
          "plain_text": "1 and 2 only"
        },
        "C": {
          "text": "1 and 3 only",
          "math_alt": [],
          "plain_text": "1 and 3 only"
        },
