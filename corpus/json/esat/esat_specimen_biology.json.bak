        "C": "lowest concentration of urea: 3 is the renal artery, highest concentration of urea: 5 is the urethra",
        "D": "lowest concentration of urea: 3 is the renal vein, highest concentration of urea: 5 is the ureter",
        "E": "lowest concentration of urea: 4 is the renal vein, highest concentration of urea: 5 is the ureter",
        "F": "lowest concentration of urea: 4 is the renal artery, highest concentration of urea: 5 is the urethra"
      }
