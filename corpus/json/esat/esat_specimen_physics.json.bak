                    "text": "S only",
                    "math_alt": [],
                    "plain_text": "S only"
                },
                "C": {
                    "text": "P and Q only",
                    "math_alt": [],
                    "plain_text": "P and Q only"
                },
                "D": {
                    "text": "P and R only",
                    "math_alt": [],
                    "plain_text": "P and R only"
                },
                "E": {
                    "text": "Q and S only",
                    "math_alt": [],
                    "plain_text": "Q and S only"
                },
                "F": {
                    "text": "R and S only",
                    "math_alt": [],
                    "plain_text": "R and S only"
