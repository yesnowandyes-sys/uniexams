            "paper": "ESAT",
            "module": "physics",
            "question_number": 16,
            "question_text": "Nuclide   is an unstable isotope which decays in two stages into nuclide Z as shown:\n\n                              \n\n \n\nWhat are the values of P and Q ?\n\n(Consider only alpha and beta decays.)",
            "question_images": [],
            "screenshot": "esat_screenshots/physics/q16.png",
            "explanation_screenshot": "",
            "options": {
                "A": "P: N-4, Q: R+1",
