                "E": "loss of gravitational potential energy / J: 100 000, resistive force / N: 100",
                "F": "loss of gravitational potential energy / J: 100 000, resistive force / N: 1000 / √99"
            },
            "options_detailed": {
                "A": {
                    "text": "loss of gravitational potential energy / J: 3200, resistive force / N: 32 / √101",
                    "math_alt": [],
                    "plain_text": "loss of gravitational potential energy / J: 3200, resistive force / N: 32 / √101"
