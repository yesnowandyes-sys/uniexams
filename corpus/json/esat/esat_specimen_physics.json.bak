        {
            "id": "ESAT-SPECIMEN-PHYSICS-Q4",
            "year": "specimen",
            "paper": "ESAT",
            "module": "physics",
            "question_number": 4,
            "question_text": "A nuclide   Pb changes by radioactive decay into the nuclide Pb.\n\nWhich combination of emissions produces this change?",
            "question_images": [],
            "screenshot": "esat_screenshots/physics/q04.png",
            "explanation_screenshot": "",
            "options": {
                "A": "3 alpha",
                "B": "2 alpha and 1 beta",
                "C": "2 alpha and 2 beta",
                "D": "1 alpha and 2 beta",
                "E": "3 beta"
            },
            "options_detailed": {
                "A": {
                    "text": "3 alpha",
                    "math_alt": [],
                    "plain_text": "3 alpha"
                },
                "B": {
                    "text": "2 alpha and 1 beta",
                    "math_alt": [],
                    "plain_text": "2 alpha and 1 beta"
                },
                "C": {
                    "text": "2 alpha and 2 beta",
                    "math_alt": [],
                    "plain_text": "2 alpha and 2 beta"
                },
                "D": {
                    "text": "1 alpha and 2 beta",
                    "math_alt": [],
                    "plain_text": "1 alpha and 2 beta"
                },
                "E": {
                    "text": "3 beta",
                    "math_alt": [],
                    "plain_text": "3 beta"
                }
            },
            "correct_answer": "D",
            "correct_answer_raw": "blank presubscript 82 presuperscript 214",
            "correct_answer_plain": "",
            "correct_answer_images": [
                "blank presubscript 82 presuperscript 214",
                "blank presubscript 82 presuperscript 210"
            ],
            "explanation": "Alpha decay involves the emission of a helium nucleus: 2 protons and 2 neutrons. The atomic number of the emitting nucleus goes down by two, and the atomic mass (nucleon number) goes down by four.\nBeta decay involves the emission of an electron from the nucleus. In this process a neutron changes into a proton; the atomic number of the emitting nucleus goes up by one, and the atomic mass remains the same.\nThe atomic mass of Pb has decreased by 4 to give Pb, so an alpha particle has been emitted. Since the atomic number has not changed, the two protons lost by alpha emission must have been replaced by the emission of two beta particles.\nThe correct answer is therefore 1 alpha and 2 beta.",
            "explanation_images": [
                "blank presubscript 82 presuperscript 214",
                "blank presubscript 82 presuperscript 210"
            ],
            "extracted_at": "2026-07-04T23:56:42.482208",
            "options_latex": {
                "A": "3 alpha",
                "B": "2 alpha and 1 beta",
                "C": "2 alpha and 2 beta",
                "D": "1 alpha and 2 beta",
                "E": "3 beta"
            },
            "question_images_latex": [
                "blank presubscript 82 presuperscript 214",
                "blank presubscript 82 presuperscript 210"
            ]
        },
