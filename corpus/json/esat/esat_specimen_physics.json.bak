                },
                "C": {
                    "text": "loss of gravitational potential energy / J: 3200, resistive force / N: 32 / √99",
                    "math_alt": [],
                    "plain_text": "loss of gravitational potential energy / J: 3200, resistive force / N: 32 / √99"
                },
                "D": {
                    "text": "loss of gravitational potential energy / J: 100 000, resistive force / N: 1000 / √101",
                    "math_alt": [],
                    "plain_text": "loss of gravitational potential energy / J: 100 000, resistive force / N: 1000 / √101"
                },
                "E": {
                    "text": "loss of gravitational potential energy / J: 100 000, resistive force / N: 100",
                    "math_alt": [],
                    "plain_text": "loss of gravitational potential energy / J: 100 000, resistive force / N: 100"
