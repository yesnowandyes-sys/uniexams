        {
            "id": "ESAT-SPECIMEN-MATHS1-Q4",
            "year": "specimen",
            "paper": "ESAT",
            "module": "maths1",
            "question_number": 4,
            "question_text": "The ratio of Q : R is 5 : 2 and the ratio of R : S is 3 : 10\n\nWhich one of the following gives the ratio Q : S in its simplest form?",
            "question_images": [],
            "screenshot": "esat_screenshots/maths1/q04.png",
            "explanation_screenshot": "",
            "options": {
                "A": "1 : 2",
                "B": "2 : 1",
                "C": "3 : 4",
                "D": "3 : 25",
                "E": "4 : 3",
                "F": "25 : 3"
            },
            "options_detailed": {
                "A": {
                    "text": "1 : 2",
                    "math_alt": [],
                    "plain_text": "1 : 2"
